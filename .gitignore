*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 测试覆盖率产物
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# OS / editor
.DS_Store
Thumbs.db
.idea/
