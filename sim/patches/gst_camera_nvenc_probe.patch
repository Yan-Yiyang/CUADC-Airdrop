+//////////////////////////////////////////////////
+// Check whether the NVIDIA encoder can really be brought up on this host.
+// Creating the element is not enough to tell: on some driver stacks (for
+// example a WSL setup where the NVENC path is unavailable) nvh264enc is
+// created successfully but then fails with "Selected preset not supported".
+// Without this probe the plugin would settle on an encoder that never
+// produces a single frame.
+static bool nvencH264Usable()
+{
+	GstElement *pipeline = gst_pipeline_new(nullptr);
+	GstElement *source = gst_element_factory_make("videotestsrc", nullptr);
+	GstElement *converter = gst_element_factory_make("videoconvert", nullptr);
+	GstElement *encoder = gst_element_factory_make("nvh264enc", nullptr);
+	GstElement *sink = gst_element_factory_make("fakesink", nullptr);
+
+	if (!pipeline || !source || !converter || !encoder || !sink) {
+		if (pipeline) { gst_object_unref(pipeline); }
+
+		if (source) { gst_object_unref(source); }
+
+		if (converter) { gst_object_unref(converter); }
+
+		if (encoder) { gst_object_unref(encoder); }
+
+		if (sink) { gst_object_unref(sink); }
+
+		return false;
+	}
+
+	g_object_set(G_OBJECT(source), "num-buffers", 2, NULL);
+
+	bool usable = false;
+	gst_bin_add_many(GST_BIN(pipeline), source, converter, encoder, sink, NULL);
+
+	if (gst_element_link_many(source, converter, encoder, sink, NULL) &&
+	    gst_element_set_state(pipeline, GST_STATE_PLAYING) != GST_STATE_CHANGE_FAILURE) {
+		GstBus *bus = gst_element_get_bus(pipeline);
+		GstMessage *msg = bus ? gst_bus_timed_pop_filtered(
+					  bus, 5 * GST_SECOND,
+					  (GstMessageType)(GST_MESSAGE_ERROR | GST_MESSAGE_EOS)) : nullptr;
+
+		usable = msg && GST_MESSAGE_TYPE(msg) == GST_MESSAGE_EOS;
+
+		if (msg) { gst_message_unref(msg); }
+
+		if (bus) { gst_object_unref(bus); }
+	}
+
+	gst_element_set_state(pipeline, GST_STATE_NULL);
+	gst_object_unref(pipeline);
+
+	return usable;
+}
